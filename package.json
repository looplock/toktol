{
  "name": "toktol",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Toktol —— 本地优先的 AI 编程工具用量仪表盘",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "pnpm run verify:deps && pnpm run verify:constants && pnpm run verify:api && pnpm run verify:theme-tokens && pnpm run verify:style && pnpm run verify:i18n && pnpm run verify:lint && pnpm run verify:version && cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && tsc --noEmit",
    "tauri": "tauri",
    "verify:version": "node scripts/verify-release-version.mjs",
    "verify:constants": "node scripts/verify-constants-parity.mjs",
    "verify:api": "node scripts/verify-api-parity.mjs",
    "verify:theme-tokens": "node scripts/verify-theme-tokens.mjs",
    "verify:style": "node scripts/verify-style-tokens.mjs",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "verify:lint": "oxlint --deny-warnings src",
    "verify:deps": "node scripts/verify-declared-deps.mjs --strict"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lobehub/icons-static-svg": "^1.95.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "echarts": "^6.1.0",
    "gridstack": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
